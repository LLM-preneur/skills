{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.artifactsend/mcp",
  "title": "ArtifactSend",
  "description": "Share docs, decks, HTML and Claude artifacts as tracked links and data rooms. See who read them.",
  "version": "1.0.0",
  "websiteUrl": "https://artifactsend.com",
  "repository": {
    "url": "https://github.com/LLM-preneur/skills",
    "source": "github",
    "subfolder": "artifactsend"
  },
  "icons": [
    {
      "src": "https://artifactsend.com/assets/icon.svg",
      "mimeType": "image/svg+xml"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://artifactsend.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "artifactsend",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ARTIFACTSEND_TOKEN",
          "description": "Token from https://artifactsend.com/app/settings",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
